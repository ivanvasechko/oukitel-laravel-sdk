{
  "name": "ivanvasechko/oukitel-laravel-sdk",
  "description": "Unofficial Laravel integration for the Oukitel cloud SDK with native HTTP, cache and testing support.",
  "type": "library",
  "license": "PolyForm-Noncommercial-1.0.0",
  "authors": [
    {
      "name": "Ivan Vasechko",
      "homepage": "https://github.com/ivanvasechko"
    }
  ],
  "require": {
    "php": "^8.2",
    "guzzlehttp/psr7": "^2.9 || ^3.0",
    "illuminate/cache": "^12.0 || ^13.0",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/log": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "ivanvasechko/oukitel-php-sdk": "^0.3",
    "psr/clock": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^2.0 || ^3.0",
    "psr/simple-cache": "^2.0 || ^3.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.29.3",
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
    "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "IvanVasechko\\Oukitel\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IvanVasechko\\Oukitel\\Laravel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "test-coverage": "pest --coverage --min=90",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "pint": "pint"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": false
    },
    "sort-packages": true
  }
}
